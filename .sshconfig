Host gitlab.com
  PreferredAuthentications publickey

Host github.com
  Hostname ssh.github.com
  Port 443
  User git
  PreferredAuthentications publickey

# https://docs.tangled.org/quick-start-guide#configure-ssh
Host tangled.org
  Hostname tangled.org
  User git
  AddressFamily inet
  PreferredAuthentications publickey
  # IdentityFile ~/.dotfiles/.ssh/id_ed25519.pub

Host *
  # No IdentityAgent: ssh uses SSH_AUTH_SOCK. `just ssh-add-key` loads
  # Agentic / "Agent SSH Key" into that agent via the service account token.
  PreferredAuthentications publickey
  SetEnv TERM=xterm-256color

Host s0003524
  User root

Host leno0
  User root

Host locally0
  User root
