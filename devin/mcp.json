{
	"mcpServers": {
		"betterstack": {
			"url": "https://mcp.betterstack.com",
			"transport": "http"
		},
		"cloudflare": {
			"url": "https://mcp.cloudflare.com/mcp",
			"transport": "http"
		},
		"datadog": {
			"url": "https://mcp.datadoghq.eu/v1/mcp?toolsets=core",
			"transport": "http"
		},
		"exa": {
			"url": "https://mcp.exa.ai/mcp?login",
			"transport": "http"
		},
		"firecrawl": {
			"url": "https://mcp.firecrawl.dev/v2/mcp-oauth",
			"transport": "http"
		},
		"github": {
			"url": "https://api.githubcopilot.com/mcp/",
			"transport": "http",
			"headers": { "Authorization": "Bearer ${env:GITHUB_PAT}" }
		},
		"victorialogs": {
			"url": "https://victoria-logs-mcp.moose-mulley.ts.net/mcp",
			"transport": "http"
		}
	}
}
