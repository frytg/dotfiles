[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[user]
	name = Daniel Freytag
	email = daniel@frytg.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFAuD9llFHf2nw8l9ozFguQ9mdFUsc2kGsW4hnCsaWHq

[commit]
	gpgsign = true

[gpg]
	format = ssh

[gpg "ssh"]
	program = ssh-keygen
[advice]
	detachedHead = false
[credential "https://origin.cursor.com/git"]
	helper = 
	helper = !/Users/dan/.local/bin/origin credential-helper
[credential "https://origin.cursor.com"]
	helper = 
	helper = !/Users/dan/.local/bin/origin credential-helper
