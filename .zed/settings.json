				}
			],
			"prettier": {
				"allowed": false
			}
		},
		"Vue.js": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				},
				{
					"code_action": "source.fixAll.oxc"
				}
			],
			"prettier": {
				"allowed": false
			}
		},
		"YAML": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"prettier": {
				"allowed": false
			}
		}
	},
	"lsp": {
		"vtsls": {
			"settings": {
				"typescript": {
					"updateImportsOnFileMove": {
						"enabled": "always"
					}
				},
				"javascript": {
					"updateImportsOnFileMove": {
						"enabled": "always"
					}
				}
			},
			"enable_lsp_tasks": true
		},
		"json-language-server": {
			"settings": {}
		},
		"just-lsp": {
			"initialization_options": {
				"formatting": {
					"indentation": "\t"
				}
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"fmt.configPath": null,
					"run": "onSave"
				}
			}
		},
		"oxlint": {
			"initialization_options": {
				"settings": {
					"configPath": null,
					"disableNestedConfig": false,
					"fixKind": "safe_fix",
					"run": "onType",
					"unusedDisableDirectives": "deny"
				}
			}
		}
	},
	"preferred_line_length": 120,
	"project_panel": {
		"hide_hidden": false,
		"hide_root": true,
		"git_status_indicator": true,
		"bold_folder_labels": false,
		"indent_size": 20.0,
		"folder_indicator": "chevron",
		"file_icons": true,
		"entry_spacing": "comfortable",
		"hide_gitignore": false,
		"dock": "left",
		"sticky_scroll": true
	},
	"remove_trailing_whitespace_on_save": false,
	"show_whitespaces": "none",
	"soft_wrap": "editor_width",
	"tab_size": 3,
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"theme": "Dark Greeny",
	"ui_font_family": "Geist Mono",
	"ui_font_size": 12.0,
	"ui_font_weight": 300.0,
	"vim_mode": false
}
