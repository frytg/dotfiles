{
	"search": {
		"whole_word": false
	},
	"tabs": {
		"close_position": "left",
		"file_icons": false,
		"git_status": true
	},
	"tab_bar": {
		"show_pinned_tabs_in_separate_row": false,
		"show_tab_bar_buttons": false,
		"show_nav_history_buttons": false,
		"show": true
	},
	"title_bar": {
		"open_menus_on_hover": false,
		"show_menus": false,
		"show_user_picture": true,
		"show_user_menu": true,
		"show_sign_in": true,
		"show_onboarding_banner": false,
		"show_project_items": true,
		"show_worktree_name": true,
		"show_branch_name": true,
		"show_branch_status_icon": false
	},
	"agent": {
		"default_model": {
			"model": "deepseek/deepseek-v4-flash",
			"provider": "openrouter"
		},
		"dock": "right",
		"model_parameters": []
	},
	"agent_servers": {
		"cursor": {
			"type": "registry"
		},
		"pi-acp": {
			"type": "registry"
		}
	},
	"agent_ui_font_size": 12.0,
	"auto_install_extensions": {
		"dockerfile": true,
		"html": true,
		"just": true,
		"nix": true,
		"oxc": true,
		"pkl": true,
		"terraform": true,
		"toml": true,
		"vue": true
	},
	"base_keymap": "VSCode",
	"buffer_font_family": "Geist Mono",
	"buffer_font_size": 13.0,
	"buffer_font_weight": 300.0,
	"buffer_line_height": "comfortable",
	"code_actions_on_format": {
		"source.fixAll.oxc": true
	},
	"collaboration_panel": {
		"button": false
	},
	"diff_view_style": "unified",
	"edit_predictions": {
		"provider": "copilot"
	},
	"format_on_save": "on",
	"formatter": "auto",
	"git": {
		"auto_fetch": {
			"enabled": true,
			"interval_secs": 600
		},
		"inline_blame": {
			"enabled": true,
			"min_column": 60,
			"show_commit_summary": true
		}
	},
	"git_panel": {
		"dock": "right",
		"group_by": "none",
		"tree_view": true
	},
	"hard_tabs": true,
	"languages": {
		"Astro": {
			"code_actions_on_format": {
				"source.fixAll.oxc": true
			},
			"formatter": [],
			"prettier": {
				"allowed": false
			}
		},
		"CSS": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"prettier": {
				"allowed": false
			}
		},
		"GraphQL": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"prettier": {
				"allowed": false
			}
		},
		"HTML": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"prettier": {
				"allowed": false
			}
		},
		"Handlebars": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"prettier": {
				"allowed": false
			}
		},
		"JSON": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"prettier": {
				"allowed": false
			}
		},
		"JSON5": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"prettier": {
				"allowed": false
			}
		},
		"JSONC": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"prettier": {
				"allowed": false
			}
		},
		"JSX": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				},
				{
					"code_action": "source.fixAll.oxc"
				}
			],
			"prettier": {
				"allowed": false
			}
		},
		"JavaScript": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				},
				{
					"code_action": "source.fixAll.oxc"
				}
			],
			"prettier": {
