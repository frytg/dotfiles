{
	"agent": {
		"default_model": {
			"model": "deepseek/deepseek-v4-flash",
			"provider": "openrouter"
		},
		"dock": "right",
		"model_parameters": []
	},
	"agent_servers": {
		"cursor": {
			"type": "registry"
		},
		"pi-acp": {
			"type": "registry"
		}
	},
	"agent_ui_font_size": 12.0,
	"auto_install_extensions": {
		"dockerfile": true,
		"html": true,
		"just": true,
		"nix": true,
		"oxc": true,
		"terraform": true,
		"toml": true,
		"vue": true,
		"pkl": true
	},
	"base_keymap": "VSCode",
	"buffer_font_family": "IBM Plex Mono",
	"buffer_font_size": 13.0,
	"buffer_font_weight": 350.0,
	"buffer_line_height": "comfortable",
	"code_actions_on_format": {
		"source.fixAll.oxc": true
	},
	"collaboration_panel": {
		"button": false
	},
	"diff_view_style": "split",
	"edit_predictions": {
		"provider": "copilot"
	},
	"format_on_save": "on",
	"formatter": "auto",
	"git": {
		"inline_blame": {
			"enabled": true,
			"min_column": 60,
			"show_commit_summary": true
		}
	},
	"git_panel": {
		"dock": "left",
		"group_by": "none",
		"tree_view": true
	},
	"hard_tabs": true,
	"languages": {
		"Astro": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				},
				{
					"code_action": "source.fixAll.oxc"
				}
			]
		},
		"CSS": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"GraphQL": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"HTML": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"JSON": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"JSONC": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"JSX": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				},
				{
					"code_action": "source.fixAll.oxc"
				}
			]
		},
		"JavaScript": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				},
				{
					"code_action": "source.fixAll.oxc"
				}
			]
		},
		"Markdown": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"SCSS": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		},
		"Svelte": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				},
				{
					"code_action": "source.fixAll.oxc"
				}
			]
		},
		"TSX": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				},
				{
					"code_action": "source.fixAll.oxc"
				}
			]
		},
		"TypeScript": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				},
				{
					"code_action": "source.fixAll.oxc"
				}
			]
		},
		"Vue.js": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				},
				{
					"code_action": "source.fixAll.oxc"
				}
			]
		},
		"YAML": {
			"prettier": {
				"allowed": false
			},
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			]
		}
	},
	"lsp": {
		"json-language-server": {
			"settings": {}
		},
		"just-lsp": {
			"initialization_options": {
				"formatting": {
					"indentation": "\t"
				}
			}
		},
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"fmt.configPath": null,
					"run": "onSave"
				}
			}
		},
		"oxlint": {
			"initialization_options": {
				"settings": {
					"configPath": null,
					"run": "onType",
					"disableNestedConfig": false,
					"fixKind": "safe_fix",
					"unusedDisableDirectives": "deny"
				}
			}
		}
	},
	"preferred_line_length": 120,
	"project_panel": {
		"dock": "left",
		"sticky_scroll": true
	},
	"remove_trailing_whitespace_on_save": false,
	"show_whitespaces": "none",
	"soft_wrap": "editor_width",
	"tab_size": 3,
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"theme": "Dark Greeny",
	"ui_font_family": "IBM Plex Mono",
	"ui_font_size": 12.0,
	"ui_font_weight": 350.0,
	"vim_mode": false
}
