			}
		},
		"Svelte": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				},
				{
					"code_action": "source.fixAll.oxc"
				}
			],
			"prettier": {
				"allowed": false
			}
		},
		"TOML": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				}
			],
			"prettier": {
				"allowed": false
			}
		},
		"TSX": {
			"formatter": [
				{
					"language_server": {
						"name": "oxfmt"
					}
				},
				{
					"code_action": "source.fixAll.oxc"
				}
			],
			"prettier": {
