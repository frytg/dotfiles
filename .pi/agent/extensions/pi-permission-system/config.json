{
	"$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/refs/heads/main/packages/pi-permission-system/schemas/permissions.schema.json",
	"debugLog": true,
	"permissionReviewLog": true,
	"yoloMode": true,
	"permission": {
		"*": "allow",
		"path": {
			"*": "allow",
			"*.env": "deny",
			"*.env.*": "deny",
			"*.env.example": "ask",
			"~/.ssh/*": "deny",
			"~/.age/*": "deny",
			"~/.age-*": "deny",
			"**/id_rsa*": "deny",
			"**/id_ed25519*": "deny",
			"**/*.pem": "deny",
			"**/*.key": "deny"
		},
		"bash": {
			"*": "allow",
			"git *": "allow",
			"git add *": "ask",
			"git am *": "ask",
			"git apply *": "ask",
			"git branch -d *": "ask",
			"git branch -D *": "ask",
			"git branch -m *": "ask",
			"git branch -M *": "ask",
			"git checkout *": "ask",
			"git cherry-pick *": "ask",
			"git clean *": "ask",
			"git clone *": "ask",
			"git commit *": "ask",
			"git config *": "ask",
			"git config --get *": "allow",
			"git config --list *": "allow",
			"git fetch *": "ask",
			"git init *": "ask",
			"git merge *": "ask",
			"git mv *": "ask",
			"git pull *": "ask",
			"git push *": "ask",
			"git rebase *": "ask",
			"git remote add *": "ask",
			"git remote remove *": "ask",
			"git remote rm *": "ask",
			"git remote set-url *": "ask",
			"git remote rename *": "ask",
			"git reset *": "ask",
			"git restore *": "ask",
			"git revert *": "ask",
			"git rm *": "ask",
			"git stash *": "ask",
			"git stash list *": "allow",
			"git stash show *": "allow",
			"git switch *": "ask",
			"git tag *": "ask",
			"git tag -l *": "allow",
			"git tag --list *": "allow",
			"git worktree add *": "ask",
			"git worktree remove *": "ask",
			"git worktree prune *": "ask",
			"git worktree move *": "ask",
			"gh *": "ask",
			"gh issue *": "allow",
			"gh pr view *": "allow",
			"gh pr list *": "allow",
			"gh pr checks *": "allow",
			"gh pr diff *": "allow",
			"gh pr status *": "allow",
			"gh repo view *": "allow",
			"gh status *": "allow",
			"gh api *": "ask",
			"gh label list *": "allow",
			"gh release list *": "allow",
			"gh release view *": "allow",
			"gh run list *": "allow",
			"gh run view *": "allow",
			"gh workflow list *": "allow",
			"gh workflow view *": "allow",
			"kubectl *": "allow",
			"kubectl exec *": "ask",
			"kubectl patch *": "ask",
			"kubectl apply *": "ask",
			"kubectl delete *": "ask",
			"kubectl edit *": "ask",
			"kubectl create *": "ask",
			"kubectl replace *": "ask",
			"kubectl scale *": "ask",
			"kubectl rollout *": "ask",
			"kubectl cordon *": "ask",
			"kubectl uncordon *": "ask",
			"kubectl drain *": "ask",
			"kubectl taint *": "ask",
			"kubectl get secrets *": "ask",
			"python *": "deny",
			"python3 *": "deny",
			"rm -rf *": "deny",
			"sops *": "ask",
			"sudo *": "ask"
		},
		"external_directory": {
			"*": "ask",
			"~/Downloads/_DEV/frytg-note-vault/*": "allow",
			"~/.agents/*": "allow",
			"/Users/dan/.agents/skills/": "allow",
			"/Users/frytg/.agents/skills/": "allow",
			"~/.bun/install/global/node_modules/@earendil-works/*": "allow"
		}
	}
}
