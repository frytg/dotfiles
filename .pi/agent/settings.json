{
  "lastChangelogVersion": "1.1.0",
  "theme": "dark",
  "httpIdleTimeoutMs": 300000,
  "defaultProvider": "xai",
  "defaultModel": "grok-4.7",
  "defaultThinkingLevel": "high",
  "enableInstallTelemetry": true,
  "enableAnalytics": false,
  "defaultProjectTrust": "ask",
  "externalEditor": "zed",
  "packages": [
    "npm:@mobrienv/pi-tidy-tools",
    "npm:@datadog/pi-plugin",
    "npm:@gotgenes/pi-permission-system"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "hideThinkingBlock": true,
  "npmCommand": [
    "mise",
    "exec",
    "node@26",
    "--",
    "npm"
  ],
  "terminal": {
    "showImages": true,
    "imageWidthCells": 60,
    "showTerminalProgress": true
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "enableSkillCommands": true,
  "showHardwareCursor": false,
  "transport": "auto",
  "tuiMode": "fullscreen",
  "doubleEscapeAction": "none",
  "collapseChangelog": true,
  "showCacheMissNotices": false,
  "outputPad": 1,
  "editorPaddingX": 0,
  "defaultTools": [
    "+codemode"
  ],
  "enabledModels": [
    "mistral/codestral-latest",
    "mistral/mistral-large-latest",
    "mistral/mistral-medium-latest",
    "mistral/mistral-small-latest",
    "mistral/zai-glm-5-3",
    "xai/grok-4.7",
    "feather/minimax/MiniMax-M3",
    "feather/omlx/Qwen3.5-9B-4bit",
    "feather/omlx/Qwen3.8-27B-4bit",
    "feather/omlx/Ternary-Bonsai-2-27B-mlx-2bit",
    "feather/omlx/Ternary-Bonsai-27B-mlx-2bit",
    "feather/omlx/Ternary-Bonsai-8B-mlx-2bit",
    "feather/omlx/gemma-4-31b-it-4bit",
    "feather/omlx/gemma-4-E4B-it-MLX-5bit",
    "feather/openrouter/moonshotai/kimi-k3",
    "feather/openrouter/openai/gpt-6-astra",
    "feather/openrouter/openai/gpt-6-astra-pro",
    "feather/openrouter/~anthropic/claude-haiku-latest",
    "feather/openrouter/~anthropic/claude-opus-latest",
    "feather/openrouter/~anthropic/claude-sonnet-latest",
    "feather/openrouter/~deepseek/deepseek-v4-flash-latest",
    "feather/openrouter/~google/gemini-flash-latest",
    "feather/openrouter/~google/gemini-pro-latest",
    "feather/openrouter/~x-ai/grok-latest",
    "feather/openrouter/~z-ai/glm-flash-latest",
    "feather/openrouter/~z-ai/glm-latest",
    "mistral/mistral-large-4"
  ]
}