# sandbox-specific zsh config. applied by sandbox/provision.sh (symlinked to ~/.zshrc).
# designed for ephemeral sandboxes — minimal, opinionated, points at dotfiles-managed tools.

# path order: ~/.local/bin (mise, fx) → mise shims (just, bun, deno) → bun → bun pkgs (pi)
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$HOME/.bun/bin:$HOME/.bun/install/global/node_modules/.bin:$PATH"

# mise per-shell activation (idempotent — sets up env shims for the current shell)
if command -v mise >/dev/null 2>&1; then
	eval "$(mise activate zsh)"
fi

# in-sandbox shortcuts
alias j='just'
alias m='mise'

# prompt: show the sandbox hostname so you don't forget you're not on your laptop
PROMPT='%F{cyan}[${HOST%%.*}]%f %F{yellow}%~%f %# '
