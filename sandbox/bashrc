# sandbox-specific bash config. applied by sandbox/provision.sh (symlinked to ~/.bashrc).
# mirrors sandbox/zshrc — kept in sync manually for now (rare to edit both).

export PATH="$HOME/.local/share/mise/shims:$PATH"
eval "$(mise activate bash)"
export PATH="$HOME/.bun/install/global/node_modules/.bin:$PATH"

alias j='just'
alias m='mise'
