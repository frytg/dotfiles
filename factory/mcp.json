{
	"mcpServers": {
		"cua-driver": {
			"type": "stdio",
			"command": "/Users/dan/.local/bin/cua-driver",
			"args": ["mcp"]
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "Bearer ${GITHUB_PAT}"
			},
			"oauth": false,
			"enabledTools": [
				"add_issue_comment",
				"create_pull_request",
				"get_commit",
				"get_file_contents",
				"get_label",
				"get_latest_release",
				"get_me",
				"get_release_by_tag",
				"get_tag",
				"issue_read",
				"issue_write",
				"list_branches",
				"list_commits",
				"list_issue_fields",
				"list_issue_types",
				"list_issues",
				"list_pull_requests",
				"list_releases",
				"list_repository_collaborators",
				"list_tags",
				"pull_request_read",
				"search_code",
				"search_commits",
				"search_issues",
				"search_pull_requests",
				"search_repositories",
				"search_users",
				"sub_issue_write"
			]
		}
	}
}
