{
	"outputStyle": "concise",
	"statusLine": {
		"type": "command",
		"command": "\"$HOME/.factory/statusline.sh\"",
		"maxRows": 1
	},
	"logoAnimation": "off",
	"completionSound": "off",
	"awaitingInputSound": "off",
	"customModels": [
		{
			"model": "uzu/alibaba:qwen3.6:27b:mirai:mirai-m:4",
			"displayName": "Feather: Uzu Qwen3.6 27B",
			"baseUrl": "https://llm.moose-mulley.ts.net/v1",
			"provider": "generic-chat-completion-api",
			"apiKeyHelper": "op read 'op://Agentic/Feather LLM Proxy/credential'",
			"maxOutputTokens": 8192,
			"maxContextLimit": 24000,
			"noImageSupport": true
		}
	],
	"sessionDefaultSettings": {
		"model": "auto",
		"reasoningEffort": "none",
		"interactionMode": "auto",
		"autonomyLevel": "medium",
		"autonomyMode": "auto-medium"
	},
	"theme": "factory-dark",
	"toolResultDisplay": "compact",
	"ideAutoConnect": false,
	"includeCoAuthoredByDroid": false,
	"enableDroidShield": true,
	"showThinkingInMainView": false,
	"streamAssistantResponses": true,
	"showTokenUsageIndicator": true,
	"hideChangelog": true,
	"nerdFont": false,
	"vimMode": false,
	"soundVolume": 100,
	"subagentAutonomyLevel": "inherit",
	"locale": "en",
	"reauthBannerShownTui": true,
	"modelFavorites": ["claude-opus-5-5", "glm-5.3", "gemini-4-hydrogen", "gemini-4-carbon", "claude-fable-5.2"],
	"dismissedNewModels": ["gemini-4-hydrogen", "gemini-4-carbon", "claude-fable-5.2"]
}
